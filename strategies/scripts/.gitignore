# Ignore all strategy scripts uploaded by users
*.py

# But keep this .gitignore file and the canonical Bowaka artifacts
# (the root .gitignore also negates these, but the nested one wins
# without an explicit negation here).
!.gitignore
!bowaka_prefilter.py
!bowaka_strategy.py

# Ignore log files if any
*.log

# Ignore backup files
*.bak
*.backup
*~

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Keep the directory but ignore contents
# This ensures the scripts folder exists in git but user strategies are not tracked