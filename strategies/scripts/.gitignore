# Ignore all strategy scripts uploaded by users
*.py

# But keep this .gitignore file and the canonical Bowaka artifacts
# (the root .gitignore also negates these, but the nested one wins
# without an explicit negation here).
!.gitignore
!bowaka_prefilter.py
!bowaka_strategy.py
!bowaka_analysis.py
!bowaka_counterfactuals.py
!bowaka_v2_features.py
!bowaka_v2_schemas.py
!bowaka_v2_paths.py
!bowaka_universe_builder.py

# Ignore log files if any
*.log

# Ignore backup files
*.bak
*.backup
*~

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
!bowaka_intraday_scanner.py
!bowaka_v2_volume_curve.py
!bowaka_v2_strategy.py
!bowaka_v2_backtest.py
!bowaka_v2_cost_model.py
!bowaka_v2_ablation.py
!bowaka_v2_bucket_analysis.py
!bowaka_v2_replay_data.py
!bowaka_v2_counterfactuals.py
!bowaka_v2_analysis.py
