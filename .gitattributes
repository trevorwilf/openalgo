# Default: let Git auto-detect text vs binary, but normalize text to LF
# in the repo. Windows checkouts get CRLF on text files (via core.autocrlf),
# but the canonical repo content stays LF. Critical for shell / cron / Linux
# entrypoint scripts that fail-to-execute when committed with CRLF.
* text=auto

# Force LF on every flavor of shell-executed text. CRLF on a .sh file in
# Linux/Docker produces ``/usr/bin/env: 'bash\r': No such file or directory``.
*.sh         text eol=lf
*.bash       text eol=lf
*.cron       text eol=lf
*.cfg        text eol=lf
*.supercronic text eol=lf

# Docker-related text MUST be LF. Linux Docker reads these files from the
# build context; CRLF in a Dockerfile RUN line or compose YAML
# environment value can hide as a literal carriage return in a string
# and break the container at runtime (most visibly: shell scripts that
# get embedded as compose ``command:`` strings).
Dockerfile        text eol=lf
Dockerfile.*      text eol=lf
*.dockerfile      text eol=lf
docker-compose*.yml text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf

# Force CRLF on Windows-only batch scripts. cmd.exe is tolerant either way,
# but the repo convention should match what the OS actually emits.
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Task Scheduler XMLs are UTF-16-LE with BOM (Windows schtasks emits and
# expects exactly this encoding). Treat them as binary so Git neither
# normalizes EOLs nor mangles the BOM.
strategies/scripts/BowakaPrefilter.xml  binary
*.task.xml                              binary

# Mark known-binary so Git doesn't try to diff or normalize them.
*.db         binary
*.duckdb     binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.pdf        binary
*.parquet    binary
