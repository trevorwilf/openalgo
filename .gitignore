# Phase 2 (Premier Charting System) — TradingView Advanced Charts SDK
# is FAC-licensed and never committed. Keep the README that explains
# how to drop your SDK files in locally; ignore every other file under
# `frontend/private/`.
frontend/private/**
!frontend/private/
!frontend/private/tradingview/
!frontend/private/tradingview/README.md
reports/*
# Phase 8 (2026-05-16) — bowaka prefab incident reports are tracked
# so the renderer has stable fixtures and operators see the post-
# mortems in source. The rest of reports/ remains ignored (it gets
# millions of generated artifacts).
!reports/incidents/
!reports/incidents/incident_2026_05_15_signal_fade_opg_rejections.md
!reports/incidents/incident_2026_05_15_aspi_duplicate_time_stop.md

# strategies — block user-uploaded scripts but track the canonical
# bowaka deployment artifacts (the cmd/bat/sh wrappers + xml/cron task
# definitions + canonical .py and .yaml configs operators rely on).
strategies/scripts/*
# Canonical bowaka source + configs
!strategies/scripts/bowaka_strategy.py
!strategies/scripts/bowaka_strategy.yaml
!strategies/scripts/bowaka_strategy_README.md
!strategies/scripts/bowaka_prefilter.py
!strategies/scripts/bowaka_prefilter.yaml
!strategies/scripts/bowaka_analysis.py
!strategies/scripts/bowaka_counterfactuals.py
!strategies/scripts/bowaka_change_log.txt
!strategies/scripts/bowaka_v2_config.yaml
!strategies/scripts/bowaka_universe_builder.yaml
!strategies/scripts/bowaka_universe_builder.cron
!strategies/scripts/run_bowaka_universe_builder.sh
!strategies/scripts/run_bowaka_universe_builder.bat
!strategies/scripts/bowaka_intraday_scanner.cron
!strategies/scripts/run_bowaka_intraday_scanner.sh
!strategies/scripts/run_bowaka_intraday_scanner.bat
# v2 archives
!strategies/scripts/archive/
!strategies/scripts/archive/**
# Windows launchers (.bat / .cmd / Task Scheduler XML).
# NOTE: _run_bowaka_strategy_oneshot.cmd is INTENTIONALLY NOT in the
# allowlist — operators are expected to hardcode their personal
# OPENALGO_API_KEY in that file for convenience, so it stays local
# to each machine.
!strategies/scripts/run_bowaka_prefilter.bat
!strategies/scripts/_watchdog_bowaka_strategy.cmd
!strategies/scripts/_watchdog_openalgo.cmd
!strategies/scripts/BowakaPrefilter.xml
!strategies/scripts/install_bowaka_task.cmd
# Linux launchers (.sh / cron / supercronic)
!strategies/scripts/run_bowaka_prefilter.sh
!strategies/scripts/_run_bowaka_strategy_oneshot.sh
!strategies/scripts/_watchdog_bowaka_strategy.sh
!strategies/scripts/_watchdog_openalgo.sh
!strategies/scripts/bowaka_prefilter.cron
!strategies/scripts/prefilter.supercronic
!strategies/scripts/install_bowaka_cron.sh
